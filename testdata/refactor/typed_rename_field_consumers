Renames a field in a producer module and a separate consumer module.

The consumer list is read from a file. The unrelated local Name field proves
that the consumer pass still uses object identity rather than a name match.

-- args --
rename field User.Name Title --consumers-from consumers.txt

-- consumers.txt --
consumer
unused

-- go.mod --
module example.com/producer

go 1.23

-- model/user.in.go --
package model

type User struct {
	Name string
}

-- model/user.out.go --
package model

type User struct {
	Title string
}

-- consumer/go.mod --
module example.com/consumer

go 1.23

require example.com/producer v0.0.0

replace example.com/producer => ..

-- consumer/app/app.in.go --
package app

import "example.com/producer/model"

type local struct {
	Name string
}

func Read(u model.User, v local) string {
	_ = model.User{Name: u.Name}
	return v.Name
}

-- consumer/app/app.out.go --
package app

import "example.com/producer/model"

type local struct {
	Name string
}

func Read(u model.User, v local) string {
	_ = model.User{Title: u.Title}
	return v.Name
}

-- unused/go.mod --
module example.com/unused

go 1.23

require example.com/producer v0.0.0

replace example.com/producer => ..

-- unused/noop/noop.in.go --
package noop

func Value() string { return "no reference" }
