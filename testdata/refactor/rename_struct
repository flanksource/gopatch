Renames a struct and every reference to it in the declaring package.

-- args --
rename struct HTTPClient Client --package http

-- go.mod --
module example.com/http

go 1.23

-- client.in.go --
package http

type HTTPClient struct {
	timeout int
}

func New() *HTTPClient {
	return &HTTPClient{}
}

func (c *HTTPClient) Timeout() int {
	return c.timeout
}

-- client.out.go --
package http

type Client struct {
	timeout int
}

func New() *Client {
	return &Client{}
}

func (c *Client) Timeout() int {
	return c.timeout
}

