Rename a package clause in files that also match a body. The bare clause pair,
with no body, is covered by rename_package_clause_only.

-- rename.patch --
@@
@@
-package foo
+package bar

 Foo()

-- foo.in.go --
package foo

import "fmt"

func main() {
	Foo()
}

-- foo.out.go --
package bar

import "fmt"

func main() {
	Foo()
}

-- foo.diff --
--- foo.go
+++ foo.go
@@ -1,4 +1,4 @@
-package foo
+package bar
 
 import "fmt"
 
